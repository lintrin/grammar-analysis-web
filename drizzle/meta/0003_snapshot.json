      "uniqueConstraints": {},
      "checkConstraints": {
        "frame_id": {
          "name": "frame_id",
          "value": "\"lexicon_frames\".\"id\" <> ''"
        },
        "frame_pattern": {
          "name": "frame_pattern",
          "value": "\"lexicon_frames\".\"pattern\" IN ('SV','SVO','SVC','SVOO','SVOC')"
        },
        "frame_flags": {
          "name": "frame_flags",
          "value": "\"lexicon_frames\".\"allow_progressive\" IN (0,1) AND \"lexicon_frames\".\"allow_perfect\" IN (0,1)"
        },
        "frame_recipient": {
          "name": "frame_recipient",
          "value": "\"lexicon_frames\".\"recipient\" IS NULL OR \"lexicon_frames\".\"recipient\" = 'person'"
        },
        "frame_complement": {
          "name": "frame_complement",
          "value": "\"lexicon_frames\".\"complement\" IS NULL OR \"lexicon_frames\".\"complement\" IN ('single-adjective','noun-or-single-adjective','location-phrase')"
        },
        "frame_passive": {
          "name": "frame_passive",
          "value": "\"lexicon_frames\".\"passive_promotion\" IS NULL OR \"lexicon_frames\".\"passive_promotion\" IN ('direct-object','direct-object-or-recipient')"
        },
        "frame_tail": {
          "name": "frame_tail",
          "value": "\"lexicon_frames\".\"fixed_tail\" IS NULL OR \"lexicon_frames\".\"fixed_tail\" = 'to school'"
        },
        "frame_shape": {
          "name": "frame_shape",
          "value": "(\"lexicon_frames\".\"pattern\" = 'SVOO') = (\"lexicon_frames\".\"recipient\" IS NOT NULL) AND\n    (\"lexicon_frames\".\"pattern\" IN ('SVC','SVOC')) = (\"lexicon_frames\".\"complement\" IS NOT NULL) AND\n    (\"lexicon_frames\".\"passive_promotion\" IS NULL OR (\"lexicon_frames\".\"pattern\" = 'SVO' AND \"lexicon_frames\".\"passive_promotion\" = 'direct-object') OR (\"lexicon_frames\".\"pattern\" = 'SVOO' AND \"lexicon_frames\".\"passive_promotion\" = 'direct-object-or-recipient')) AND\n    (\"lexicon_frames\".\"fixed_tail\" IS NULL OR \"lexicon_frames\".\"pattern\" = 'SV')"
        },
        "frame_json": {
          "name": "frame_json",
          "value": "json_valid(\"lexicon_frames\".\"allowed_purposes_json\") AND json_valid(\"lexicon_frames\".\"allowed_polarities_json\")"
        },
        "frame_location": {
          "name": "frame_location",
          "value": "\"lexicon_frames\".\"location_json\" IS NULL OR COALESCE((json_valid(\"lexicon_frames\".\"location_json\") AND json_type(\"lexicon_frames\".\"location_json\")='object' AND\n    json_type(\"lexicon_frames\".\"location_json\",'$.policyId')='text' AND json_extract(\"lexicon_frames\".\"location_json\",'$.policyId') IN ('basic-object-location','legacy-sv-location','legacy-sv-under-location') AND\n    json_type(\"lexicon_frames\".\"location_json\",'$.attachment')='text' AND json_type(\"lexicon_frames\".\"location_json\",'$.presence')='text' AND \"lexicon_frames\".\"fixed_tail\" IS NULL AND\n    ((json_extract(\"lexicon_frames\".\"location_json\",'$.attachment')='complement' AND json_extract(\"lexicon_frames\".\"location_json\",'$.presence')='required' AND json_extract(\"lexicon_frames\".\"location_json\",'$.policyId')='basic-object-location' AND \"lexicon_frames\".\"pattern\"='SVC' AND \"lexicon_frames\".\"complement\"='location-phrase' AND \"lexicon_frames\".\"allow_progressive\"=0 AND \"lexicon_frames\".\"allow_perfect\"=0 AND \"lexicon_frames\".\"passive_promotion\" IS NULL) OR\n     (json_extract(\"lexicon_frames\".\"location_json\",'$.attachment')='adverbial' AND json_extract(\"lexicon_frames\".\"location_json\",'$.presence')='optional' AND json_extract(\"lexicon_frames\".\"location_json\",'$.policyId') IN ('legacy-sv-location','legacy-sv-under-location') AND \"lexicon_frames\".\"pattern\"='SV' AND \"lexicon_frames\".\"complement\" IS NULL))),0)"
        },
        "frame_location_complement": {
          "name": "frame_location_complement",
          "value": "(\"lexicon_frames\".\"complement\"='location-phrase') IS NOT 1 OR \"lexicon_frames\".\"location_json\" IS NOT NULL"
        }
      }
    },
