    {"id":"simple-01","group":"simple","input":"The small children ran yesterday.","clauses":[{"pattern":"SV","tense":"past","parts":[["subject","The small children",["small"]],["verb","ran"],["adverbial","yesterday"]],"aspect":"simple","voice":"active"}]},
